<?xml version="1.0" encoding="utf-8"?>
<!-- Só no APK de demonstração em rede local (build com -P evofit.allowHttp=true,
     scripts/build-apk.ps1 -AllowHttp, ADR-067): HTTP sem TLS liberado para falar com
     a API num computador da mesma rede. O APK normal usa network_security_config.xml,
     que exige HTTPS. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
