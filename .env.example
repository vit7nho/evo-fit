# Copie para .env e ajuste. NUNCA versione o .env.

# --- Geral ---
APP_NAME=EvoFit
# development | test | production
APP_ENV=development
LOG_LEVEL=INFO

# --- Banco ---
# docker = os scripts sobem o PostgreSQL pelo Docker Compose (padrão).
# local  = PostgreSQL instalado na máquina; os scripts não chamam o Docker
#          (crie o usuário e os bancos conforme docs/SETUP.md, seção 8).
DB_MODE=docker

# Usados pelo Docker Compose. Portas no host diferentes de 5432 para não
# conflitar com um PostgreSQL instalado na máquina.
POSTGRES_USER=evofit
POSTGRES_PASSWORD=evofit_dev_only
POSTGRES_DB=evofit
POSTGRES_PORT=5442
POSTGRES_TEST_PORT=5443

# URL usada pela API ao rodar fora do Docker (uvicorn local).
DATABASE_URL=postgresql+psycopg://evofit:evofit_dev_only@127.0.0.1:5442/evofit
# URL usada pelo pytest. ATENÇÃO: os testes apagam e recriam as tabelas deste banco.
TEST_DATABASE_URL=postgresql+psycopg://evofit:evofit_dev_only@127.0.0.1:5443/evofit_test

# --- API ---
API_PORT=8000
# Origens permitidas (site em dev). Separadas por vírgula.
CORS_ORIGINS=http://localhost:3000

# --- Autenticação ---
# Segredo de assinatura dos tokens (mínimo 32 caracteres). Gere um valor próprio:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Este valor de exemplo serve só para desenvolvimento local; nunca o use em produção.
JWT_SECRET=troque-por-um-valor-aleatorio-de-pelo-menos-32-caracteres

# --- IA (Fase 4) ---
# fake = respostas simuladas, sem custo. A chave real fica SOMENTE aqui no backend.
AI_PROVIDER=fake
# AI_API_KEY=
