# Copie para .env e ajuste. NUNCA versione o .env.

# --- Geral ---
APP_NAME=EvoFit
# development | test | production
APP_ENV=development
LOG_LEVEL=INFO

# --- Banco ---
# docker = os scripts sobem o PostgreSQL pelo Docker Compose (padrão).
# local  = PostgreSQL instalado na máquina; os scripts não chamam o Docker
#          (crie o usuário e os bancos conforme docs/SETUP.md, seção 8).
DB_MODE=docker

# Usados pelo Docker Compose. Portas no host diferentes de 5432 para não
# conflitar com um PostgreSQL instalado na máquina.
POSTGRES_USER=evofit
POSTGRES_PASSWORD=evofit_dev_only
POSTGRES_DB=evofit
POSTGRES_PORT=5442
POSTGRES_TEST_PORT=5443

# URL usada pela API ao rodar fora do Docker (uvicorn local).
DATABASE_URL=postgresql+psycopg://evofit:evofit_dev_only@127.0.0.1:5442/evofit
# URL usada pelo pytest. ATENÇÃO: os testes apagam e recriam as tabelas deste banco.
TEST_DATABASE_URL=postgresql+psycopg://evofit:evofit_dev_only@127.0.0.1:5443/evofit_test

# --- API ---
API_PORT=8000
# Origens permitidas (site em dev). Separadas por vírgula.
CORS_ORIGINS=http://localhost:3000

# --- Autenticação ---
# Segredo de assinatura dos tokens (mínimo 32 caracteres). Gere um valor próprio:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Este valor de exemplo serve só para desenvolvimento local; nunca o use em produção.
JWT_SECRET=troque-por-um-valor-aleatorio-de-pelo-menos-32-caracteres

# --- IA (Fase 4) ---
# fake = texto fixo, sem custo. demo = modo demonstração (ADR-058): responde por
# regras com os dados reais, sem IA externa e sem chave — sozinho ou no fim da lista,
# como reserva quando a cota acaba. A chave real fica SOMENTE aqui no backend.
# Provedores reais (ADR-056/057), em ordem de preferência: com a cota esgotada ou o
# serviço fora do ar, a pergunta vai ao próximo. Cada um tem a PRÓPRIA chave, que
# vai só na linha dele — NUNCA em AI_PROVIDER.
#   AI_PROVIDER=gemini,groq,demo
#   AI_GROQ_API_KEY=<chave do console.groq.com>
#   AI_GEMINI_API_KEY=<chave do Google AI Studio>
AI_PROVIDER=fake
# AI_GROQ_API_KEY=
# AI_GEMINI_API_KEY=
# Modelos (um ou uma lista; padrões: openai/gpt-oss-120b,openai/gpt-oss-20b e
# gemini-3.6-flash,gemini-3-flash-preview,gemini-3.5-flash-lite).
# AI_GROQ_MODEL=
# AI_GEMINI_MODEL=
# true se a chave do Gemini for do plano gratuito: o Google pode usar o conteúdo para
# melhorar os produtos dele; o texto livre das limitações deixa de ser enviado e o app
# avisa. (O Groq não usa o conteúdo para treinar.)
# AI_FREE_TIER=false
# Compatibilidade (4.4): AI_API_KEY/AI_MODEL valem para o primeiro provedor da lista.
# AI_API_KEY=
# AI_MODEL=
# Tempo máximo de espera por resposta do provedor, em segundos (padrão 30).
# AI_TIMEOUT_S=30
# Perguntas por pessoa: por dia (no fuso dela) e por minuto; tokens máximos por resposta.
# AI_DAILY_LIMIT=30
# AI_PER_MINUTE_LIMIT=5
# AI_MAX_TOKENS=1024
